{
  "name": "waveform-visualizer-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prebuild:android": "expo prebuild --platform android",
    "build:apk": "node scripts/build-android.mjs apk",
    "build:aab": "node scripts/build-android.mjs aab",
    "install:release": "node scripts/build-android.mjs install",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run test:release",
    "test:release": "node --test scripts/build-android.node-test.mjs plugins/withAndroidRelease.node-test.cjs plugins/withAndroidDebugNetwork.node-test.cjs",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@react-native-community/slider": "5.0.1",
    "@shopify/react-native-skia": "2.2.12",
    "expo": "~54.0.37",
    "expo-file-system": "~19.0.24",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-worklets": "^0.8.3"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2",
    "vitest": "^4.1.5"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-worklets"
      ]
    }
  },
  "private": true
}
