{
  "name": "mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:start": "expo start --android",
    "prebuild:android": "expo prebuild --platform android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.0.1",
    "@shopify/react-native-skia": "2.2.12",
    "expo": "~54.0.33",
    "expo-file-system": "~19.0.22",
    "expo-screen-orientation": "~9.0.9",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "gifenc": "^1.0.3",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-audio-api": "^0.12.1",
    "react-native-reanimated": "~4.1.1",
    "react-native-worklets": "^0.8.3"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "patch-package": "^8.0.1",
    "typescript": "~5.9.2",
    "vitest": "^4.1.5"
  },
  "expo": {
    "install": {
      "exclude": [
        "react-native-worklets"
      ]
    }
  },
  "private": true
}
